# Copy to .env and fill in

# Database
POSTGRES_USER=digifactory
POSTGRES_PASSWORD=changeme_secure_password_123
POSTGRES_DB=digifactory
DATABASE_URL=postgresql://digifactory:changeme_secure_password_123@db:5432/digifactory

# Redis
REDIS_URL=redis://redis:6379/0

# AI Services
OPENAI_API_KEY=sk-your-openai-key-here
REPLICATE_API_TOKEN=r8_your-rePLICATE-token

# Printify
PRINTIFY_SHOP_ID=your-shop-id
PRINTIFY_TOKEN=your-printify-token

# Etsy Open API v3 — physical POD flow
ETSY_API_KEY=your-etsy-api-key
ETSY_SECRET=your-etsy-shared-secret
ETSY_ACCESS_TOKEN=your-etsy-access-token
ETSY_REFRESH_TOKEN=your-etsy-refresh-token
ETSY_SHOP_ID=your-numeric-shop-id
ETSY_SHIPPING_PROFILE_ID=your-shipping-profile-id
ETSY_READINESS_STATE_ID=your-processing-profile-readiness-state-id

# Fiverr (limited API)
FIVERR_ACCESS_TOKEN=your-fiverr-token

# OpenRouter (for multi-model routing)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# App URL (for OpenRouter tracking)
APP_URL=http://localhost:3000

# Payments (402 flow)
CREEM_API_KEY=your-creem-api-key
BTCPAY_API_URL=https://btcpay.example.com
BTCPAY_STORE_ID=your-btcpay-store-id
BTCPAY_API_KEY=your-btcpay-api-key

# Google Trends (uses pytrends, no API key needed but needs proxy for scale)
TRENDS_PROXY=

# App
SECRET_KEY=your-super-secret-jwt-key
ENVIRONMENT=development

# Composio — Pauli Integrations Bus
# Create a project API key in Composio. Never commit a real key.
COMPOSIO_API_KEY=

# Terabithia Pricing Intelligence
# In Docker/private networking this should resolve to the Terabithia pricing service.
TERABITHIA_PRICING_URL=http://terabithia:3001
# Must match Terabithia's runtime secret. Never commit the real value.
TERABITHIA_API_KEY=
